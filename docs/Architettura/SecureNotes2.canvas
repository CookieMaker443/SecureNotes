{
	"nodes":[
		{"id":"login","type":"text","x":0,"y":0,"width":260,"height":110,"color":"1","text":"**LoginActivity**\nPIN/biometria.\nCrea CryptoManager, chiama SecureSession.init()+unlock(), LockManager.start()."},
		{"id":"base","type":"text","x":0,"y":160,"width":260,"height":110,"color":"1","text":"**BaseActivity**\nEstesa da tutte le Activity tranne Login.\ndispatchTouchEvent, onResume/onStop -> LockManager."},
		{"id":"ss","type":"text","x":340,"y":0,"width":260,"height":110,"color":"5","text":"**SecureSession** (singleton)\nApre/chiude NotesDatabase, FilesDatabase, StoragePaths.\ninit(cryptoManager) / getInstance() / unlock() / lock()."},
		{"id":"lm","type":"text","x":340,"y":160,"width":260,"height":110,"color":"5","text":"**LockManager** (singleton)\nDue timeout: background prolungato + inattivita (~30s).\nLockListener per notificare il trigger."},
		{"id":"app","type":"text","x":340,"y":320,"width":260,"height":110,"color":"5","text":"**SecureNotesApplication**\nUnico punto che collega LockManager -> SecureSession.lock()\ne naviga a LoginActivity."},
		{"id":"repoNote","type":"text","x":680,"y":0,"width":260,"height":100,"color":"2","text":"**NoteRepository**\nsaveNote/loadNote/searchNote/deleteNote.\nCostruttore: riceve SecureSession."},
		{"id":"repoFile","type":"text","x":680,"y":160,"width":260,"height":100,"color":"2","text":"**FileRepository**\nsaveFile/loadFile/searchFile/deleteFile.\nCostruttore: riceve SecureSession."},
		{"id":"storage","type":"text","x":680,"y":320,"width":260,"height":100,"color":"2","text":"**StoragePaths**\nGarantisce l'esistenza di Media/Video, Immagini, PDF, Notes."},
		{"id":"dbNotes","type":"text","x":1020,"y":0,"width":260,"height":90,"color":"4","text":"**NotesDatabase**\nRoomDatabase + SQLCipher (SupportFactory(dbKey))."},
		{"id":"daoNote","type":"text","x":1020,"y":140,"width":260,"height":90,"color":"4","text":"**NoteDao**\ninsert/update/delete/getById/search."},
		{"id":"entNota","type":"text","x":1020,"y":280,"width":260,"height":90,"color":"4","text":"**Nota** (Entity)\ntitolo, nomeFisico, dataCreazione, dataModifica."},
		{"id":"dbFiles","type":"text","x":1020,"y":420,"width":260,"height":90,"color":"4","text":"**FilesDatabase**\nRoomDatabase + SQLCipher (SupportFactory(dbKey))."},
		{"id":"daoFile","type":"text","x":1020,"y":560,"width":260,"height":90,"color":"4","text":"**FileDao**\ninsert/delete/getById/search/getAllByTipo."},
		{"id":"entFile","type":"text","x":1020,"y":700,"width":260,"height":90,"color":"4","text":"**FileEntry** (Entity)\nnomeOriginale, nomeFisico, tipo, dimensioneByte, dataCreazione."},
		{"id":"crypto","type":"text","x":1360,"y":0,"width":260,"height":100,"color":"6","text":"**CryptoManager**\nWrapper su Android Keystore.\nencrypt/decrypt, encryptToString/decryptFromString."},
		{"id":"cryptoEx","type":"text","x":1360,"y":140,"width":260,"height":90,"color":"6","text":"**CryptoException**\nOgni errore di cifratura propagato, mai null silenzioso."},
		{"id":"prefs","type":"text","x":1360,"y":280,"width":260,"height":100,"color":"6","text":"**SecurePrefsManager**\nPIN hash+salt, EncryptedSharedPreferences,\ngetOrCreateDatabaseKey(cryptoManager)."},
		{"id":"prefsEx","type":"text","x":1360,"y":420,"width":260,"height":90,"color":"6","text":"**SecurePrefsException**\nInizializzazione EncryptedSharedPreferences fallita."},
		{"id":"executors","type":"text","x":-340,"y":320,"width":260,"height":90,"color":"1","text":"**AppExecutors** (singleton)\ndiskIO() thread singolo + mainThread(Runnable)."},
		{"id":"noteVM","type":"text","x":-340,"y":0,"width":260,"height":100,"color":"1","text":"**NoteViewModel**\nEspone LiveData: notes, editorTitle/Content, saveCompleted, errorMessage."},
		{"id":"noteAdapter","type":"text","x":-680,"y":0,"width":260,"height":90,"color":"1","text":"**NoteAdapter**\nRecyclerView. OnNoteClickListener (tap/long-press)."},
		{"id":"notesListAct","type":"text","x":-680,"y":160,"width":260,"height":100,"color":"1","text":"**NotesListActivity**\nLista + ricerca + FAB.\nEstende BaseActivity."},
		{"id":"noteEditorAct","type":"text","x":-680,"y":320,"width":260,"height":100,"color":"1","text":"**NoteEditorActivity**\nCreazione/modifica nota (stessa Activity, id opzionale)."},
		{"id":"doc00","type":"file","x":-680,"y":900,"width":260,"height":60,"file":"00-panoramica.md"},
		{"id":"doc01","type":"file","x":-380,"y":900,"width":260,"height":60,"file":"01-livello-sicurezza.md"},
