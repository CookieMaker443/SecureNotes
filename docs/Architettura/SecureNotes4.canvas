		{"id":"svAct","type":"text","text":"**SecureViewerActivity** (astratta)\nEXTRA_FILE_ID, getFileId().\nonSupportNavigateUp() -> finish().\nEstende BaseActivity.","x":-1740,"y":0,"width":260,"height":90,"color":"3"},
		{"id":"imgViewer","type":"text","text":"**ImageViewerActivity**\nloadFile() intero in RAM -> BitmapFactory.\nNiente pinch-to-zoom (rimandato).","x":-1740,"y":130,"width":260,"height":110,"color":"3"},
		{"id":"pdfViewer","type":"text","text":"**PdfViewerActivity**\nloadFile() -> file temp 'pdf_view_*' -> ParcelFileDescriptor -> PdfRenderer.\nshowPage(index), prev/next.","x":-1740,"y":280,"width":260,"height":120,"color":"3"},
		{"id":"videoViewer","type":"text","text":"**VideoPlayerActivity**\ngetById + loadFileToStream (blocchi 64KB) -> file temp 'video_view_*' -> ExoPlayer.\ncancelled (volatile) per uscita anticipata.","x":-1740,"y":440,"width":260,"height":140,"color":"3"},
		{"id":"media3","type":"text","text":"**Media3 / ExoPlayer** (esterna)\nExoPlayer + PlayerView.\n@UnstableApi richiesta.","x":-2100,"y":440,"width":240,"height":120,"color":"6"},
		{"id":"pdfRendererNode","type":"text","text":"**PdfRenderer** (API di sistema)\nRichiede ParcelFileDescriptor reale -> impone il file temporaneo.","x":-2100,"y":240,"width":240,"height":180,"color":"6"},
		{"id":"bugNode","type":"text","text":"⚠ **BUG APERTO**\nVideo: schermo nero al play, 0:00/0:00.\nMemoria ok (niente piu GC in affanno).\nCausa non confermata.\nVedi 12-cronistoria-bug-video.md","x":-1740,"y":610,"width":260,"height":230,"color":"1"}
	],
