{
	"nodes":[
		{"id":"login","type":"text","text":"**LoginActivity**\nPIN/biometria.\nCrea CryptoManager, chiama SecureSession.init()+unlock(), LockManager.start().","x":0,"y":0,"width":260,"height":110,"color":"1"},
		{"id":"base","type":"text","text":"**BaseActivity**\nEstesa da tutte le Activity tranne Login.\ndispatchTouchEvent, onResume/onStop -> LockManager.","x":0,"y":160,"width":260,"height":110,"color":"1"},
		{"id":"ss","type":"text","text":"**SecureSession** (singleton)\nApre/chiude NotesDatabase, FilesDatabase, StoragePaths.\ninit(cryptoManager) / getInstance() / unlock() / lock().","x":340,"y":0,"width":260,"height":110,"color":"5"},
		{"id":"lm","type":"text","text":"**LockManager** (singleton)\nDue timeout: background prolungato + inattivita (~30s).\nLockListener per notificare il trigger.","x":340,"y":160,"width":260,"height":110,"color":"5"},
		{"id":"app","type":"text","text":"**SecureNotesApplication**\nUnico punto che collega LockManager -> SecureSession.lock()\ne naviga a LoginActivity.","x":340,"y":320,"width":260,"height":110,"color":"5"},
		{"id":"repoNote","type":"text","text":"**NoteRepository**\nsaveNote/loadNote/searchNote/deleteNote.\nCostruttore: riceve SecureSession.","x":680,"y":0,"width":260,"height":100,"color":"2"},
		{"id":"repoFile","type":"text","text":"**FileRepository**\nsaveFile/loadFile/searchFile/deleteFile.\nCostruttore: riceve SecureSession.\n+ getById(id) pubblico\n+ loadFileToStream(id, OutputStream): decifra a blocchi 64KB (per Video, no RAM piena).","x":680,"y":160,"width":260,"height":130,"color":"2"},
		{"id":"storage","type":"text","text":"**StoragePaths**\nGarantisce l'esistenza di Media/Video, Immagini, PDF, Notes.","x":680,"y":320,"width":260,"height":100,"color":"2"},
		{"id":"dbNotes","type":"text","text":"**NotesDatabase**\nRoomDatabase + SQLCipher (SupportFactory(dbKey)).","x":1020,"y":0,"width":260,"height":90,"color":"4"},
		{"id":"daoNote","type":"text","text":"**NoteDao**\ninsert/update/delete/getById/search.","x":1020,"y":140,"width":260,"height":90,"color":"4"},
		{"id":"entNota","type":"text","text":"**Nota** (Entity)\ntitolo, nomeFisico, dataCreazione, dataModifica.","x":1020,"y":280,"width":260,"height":90,"color":"4"},
		{"id":"dbFiles","type":"text","text":"**FilesDatabase**\nRoomDatabase + SQLCipher (SupportFactory(dbKey)).","x":1020,"y":420,"width":260,"height":90,"color":"4"},
		{"id":"daoFile","type":"text","text":"**FileDao**\ninsert/delete/getById/search/getAllByTipo.","x":1020,"y":560,"width":260,"height":90,"color":"4"},
		{"id":"entFile","type":"text","text":"**FileEntry** (Entity)\nnomeOriginale, nomeFisico, tipo, dimensioneByte, dataCreazione.","x":1020,"y":700,"width":260,"height":90,"color":"4"},
		{"id":"crypto","type":"text","text":"**CryptoManager**\nWrapper su Android Keystore.\nencrypt/decrypt, encryptToString/decryptFromString.\n+ decryptStream(InputStream): CipherInputStream sequenziale (usato da loadFileToStream).","x":1360,"y":0,"width":260,"height":120,"color":"6"},
		{"id":"cryptoEx","type":"text","text":"**CryptoException**\nOgni errore di cifratura propagato, mai null silenzioso.","x":1360,"y":140,"width":260,"height":90,"color":"6"},
		{"id":"prefs","type":"text","text":"**SecurePrefsManager**\nPIN hash+salt, EncryptedSharedPreferences,\ngetOrCreateDatabaseKey(cryptoManager).","x":1360,"y":280,"width":260,"height":100,"color":"6"},
		{"id":"prefsEx","type":"text","text":"**SecurePrefsException**\nInizializzazione EncryptedSharedPreferences fallita.","x":1360,"y":420,"width":260,"height":90,"color":"6"},
		{"id":"executors","type":"text","text":"**AppExecutors** (singleton)\ndiskIO() thread singolo + mainThread(Runnable).","x":-340,"y":320,"width":260,"height":90,"color":"1"},
		{"id":"noteVM","type":"text","text":"**NoteViewModel**\nEspone LiveData: notes, editorTitle/Content, saveCompleted, errorMessage.","x":-340,"y":0,"width":260,"height":100,"color":"1"},
		{"id":"noteAdapter","type":"text","text":"**NoteAdapter**\nRecyclerView. OnNoteClickListener (tap/long-press).","x":-680,"y":0,"width":260,"height":90,"color":"1"},
		{"id":"notesListAct","type":"text","text":"**NotesListActivity**\nLista + ricerca + FAB.\nEstende BaseActivity.","x":-680,"y":160,"width":260,"height":100,"color":"1"},
		{"id":"noteEditorAct","type":"text","text":"**NoteEditorActivity**\nCreazione/modifica nota (stessa Activity, id opzionale).","x":-680,"y":320,"width":260,"height":100,"color":"1"},
		{"id":"fileVM","type":"text","text":"**FileViewModel**\nEspone files, errorMessage.\nloadFiles/search/addFile/deleteFile/loadThumbnail(tipo).","x":-1020,"y":0,"width":260,"height":110,"color":"3"},
		{"id":"fileAdapters","type":"text","text":"**FileAdapter / FileGridAdapter**\nimplements FilesAdapter.\nGriglia con LruCache miniature per le foto.","x":-1360,"y":0,"width":260,"height":100,"color":"3"},
		{"id":"baseFileListFrag","type":"text","text":"**BaseFileListFragment**\nLogica comune: lista/ricerca/FAB/picker.\nuseGridLayout() astratto.","x":-1360,"y":160,"width":260,"height":100,"color":"3"},
		{"id":"fragments","type":"text","text":"**FotoFragment / VideoFragment / PdfFragment**\nEstendono BaseFileListFragment, differiscono per tipo/mime/layout.","x":-1360,"y":320,"width":260,"height":90,"color":"3"},
		{"id":"archivioAct","type":"text","text":"**ArchivioActivity**\nViewPager2 + TabLayout + ArchivioPagerAdapter.","x":-1360,"y":480,"width":260,"height":90,"color":"3"},
		{"id":"dashboardAct","type":"text","text":"**DashboardActivity**\n3 tasti (Note/Archivio/Impostazioni)\n+ anteprima note recenti.","x":-1020,"y":320,"width":260,"height":100,"color":"3"},
		{"id":"dashboardVM","type":"text","text":"**DashboardViewModel**\nloadRecentNotes(count).","x":-1020,"y":480,"width":260,"height":80,"color":"3"},
		{"id":"settingsAct","type":"text","text":"**SettingsActivity**\nTimeout, X note recenti, cambio PIN (via biometria), backup (placeholder).","x":-1020,"y":600,"width":260,"height":100,"color":"3"},
		{"id":"appSettings","type":"text","text":"**AppSettings**\nSharedPreferences non cifrate: timeout minuti, count note recenti.","x":-1020,"y":740,"width":260,"height":90,"color":"3"},
